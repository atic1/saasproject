# Server configuration
PORT=5000

# Database configurations (the backend checks MONGO_URI, MONGO_URL, or DATABASE_URL)
MONGO_URI=mongodb://localhost:27017/saasproject
# MONGO_URL=
# DATABASE_URL=

# Authentication secret
JWT_SECRET=yoursupersecurejwtsecretkey

# CORS configuration (comma-separated list of allowed origins)
# Set to * to allow all origins, or specify exact URLs
CORS_ORIGIN=http://localhost:5173

# Frontend URL for redirection after payment callbacks
FRONTEND_URL=http://localhost:5173

# Fully qualified public URL of this API (used for payment gateway callbacks)
# If empty, the backend dynamically constructs it from the incoming request headers
API_URL=http://localhost:5000

# eSewa Payment Provider credentials
